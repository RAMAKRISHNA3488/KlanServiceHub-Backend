{
  "name": "klanservicehub-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "deploy": "npx wrangler deploy",
    "d1:create": "npx wrangler d1 create klanservicehub_db",
    "d1:init:local": "npx wrangler d1 execute klanservicehub_db --local --file=cloudflare-d1-schema.sql",
    "d1:init:remote": "npx wrangler d1 execute klanservicehub_db --remote --file=cloudflare-d1-schema.sql"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^3.0.0",
    "dotenv": "^16.4.5",
    "hono": "^4.6.14",
    "node-appwrite": "^17.0.0",
    "nodemailer": "^9.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
